FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

// Coordenadas multiplicadas por 6 para caber a hélice de 1.016m de diâmetro
vertices
(
    (-3.60 -4.86 -3.60) // 0
    ( 3.60 -4.86 -3.60) // 1
    ( 3.60  1.26 -3.60) // 2
    (-3.60  1.26 -3.60) // 3
    (-3.60 -4.86  3.60) // 4
    ( 3.60 -4.86  3.60) // 5
    ( 3.60  1.26  3.60) // 6
    (-3.60  1.26  3.60) // 7
);

blocks
(
    // Número de células ajustado para (72 120 72) para manter a resolução
    hex (0 1 2 3 4 5 6 7) (120 102 120) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    walls
    {
        type patch;
        faces
        (
            (2 6 5 1)
            (0 3 2 1)
            (0 4 7 3)
            (4 5 6 7)
        );
    }
    inlet
    {
        type patch;
        faces
        (
            (3 7 6 2)
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (1 5 4 0)
        );
    }
);

