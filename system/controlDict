FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          incompressibleFluid;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         2500;

deltaT          1;

writeControl    timeStep;

writeInterval   50;

runTimeModifiable true;

functions
{
    forces
    {
        type            forces;
        libs            ("libforces.so");
        writeControl    timeStep;
        writeInterval   1;
        patches         (propellerTip);
        rho             rhoInf;
        rhoInf          1.225;          // Densidade do ar (kg/m3)
        CofR            (0 -0.00800165 0); // Centro de rotacao do rotor
    }

    forceCoeffs
    {
        type            forceCoeffs;
        libs            ("libforces.so");
        writeControl    timeStep;
        writeInterval   1;
        patches         (propellerTip);
        rho             rhoInf;
        rhoInf          1.225;
        CofR            (0 -0.00800165 0);
        liftDir         (0 1 0);        // Direcao do empuxo / sustentacao (+Y)
        dragDir         (0 -1 0);       // Direcao do arrasto / escoamento a jusante (-Y)
        pitchAxis       (1 0 0);        // Eixo de arfagem perpendicular (+X)
        magUInf         10.0;           // Velocidade de referencia estimada (m/s)
        lRef            1.0164;         // Diametro da helice (m)
        Aref            0.8114;         // Area de disco da helice pi*(D/2)^2 (m2)
    }
}

