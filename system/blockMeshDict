FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

// Dimensoes ampliadas para bancada estatica aberta (5D a montante, 10D a jusante, raio 5D)
// Helice D = 1.016m localizada em Y = 0
vertices
(
    (-5.00 -10.00 -5.00) // 0
    ( 5.00 -10.00 -5.00) // 1
    ( 5.00   5.00 -5.00) // 2
    (-5.00   5.00 -5.00) // 3
    (-5.00 -10.00  5.00) // 4
    ( 5.00 -10.00  5.00) // 5
    ( 5.00   5.00  5.00) // 6
    (-5.00   5.00  5.00) // 7
);

blocks
(
    // Celulas cubicas uniformes de ~83mm (120 x 180 x 120 = 2.592.000 celulas)
    hex (0 1 2 3 4 5 6 7) (120 160 120) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    walls
    {
        type patch;
        faces
        (
            (2 6 5 1)
            (0 3 2 1)
            (0 4 7 3)
            (4 5 6 7)
        );
    }
    inlet
    {
        type patch;
        faces
        (
            (3 7 6 2)
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (1 5 4 0)
        );
    }
);

