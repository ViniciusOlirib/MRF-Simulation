FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      forces;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

writeControl    timeStep;

writeInterval   1;

type            forces;
libs            ("libforces.so");
patches 	("propellerTip");
rho             rhoInf;
rhoInf          1.225;          // Densidade do ar (kg/m³)
CofR            (0 -0.00800165 0);        // Centro de rotação
p               p;              // Nome do campo de pressão
U               U;              // Nome do campo de velocidade

