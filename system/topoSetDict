FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

actions
(
    {
        name    innerCylinderSet;
        type    cellSet;
        action  new;
        source  cylinderToCell;
        sourceInfo
        {
            p1      (0 -0.10 0); // Ponto inferior no eixo Y (dentro da refinementBox)
            p2      (0  0.08 0); // Ponto superior no eixo Y (dentro da refinementBox)
            radius  0.55;        // Raio de 55cm (envolve a helice de R=50.8cm com 42mm de folga)
        }
    }
    {
        name    innerCylinder;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        sourceInfo
        {
            set     innerCylinderSet;
        }
    }
);

