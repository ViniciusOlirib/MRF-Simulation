FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

actions
(
    {
        name    innerCylinderSet;
        type    cellSet;
        action  new;
        source  cylinderToCell;
        sourceInfo
        {
            p1      (0 -0.30 0); // Estendido para 30 cm a jusante (-0.3D) para conter contracao inicial
            p2      (0  0.14 0); // Estendido para 14 cm a montante (+0.14D)
            radius  0.58;        // Raio de 58 cm (folga de 7,2 cm nas pontas, dentro da refinementBox)
        }
    }
    {
        name    innerCylinder;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        sourceInfo
        {
            set     innerCylinderSet;
        }
    }
);

