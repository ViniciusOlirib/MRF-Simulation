FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

actions
(
    {
        name    innerCylinderSet;
        type    cellSet;
        action  new;
        source  cylinderToCell;
        sourceInfo
        {
            p1      (0 -0.10 0); // 100% dentro da malha hexaedrica ortogonal nivel 4 (longe da borda Y=-0.14 e da pa)
            p2      (0  0.10 0); // 100% dentro da malha hexaedrica ortogonal nivel 4 (preserva o domo de succao acima da pa)
            radius  0.545;       // 100% dentro da malha ortogonal nivel 4 (entre a transicao da pa R=0.524 e a borda R=0.58)
        }
    }
    {
        name    innerCylinder;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        sourceInfo
        {
            set     innerCylinderSet;
        }
    }
);

