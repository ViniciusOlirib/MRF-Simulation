FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

actions
(
    {
        name    innerCylinderSet;
        type    cellSet;
        action  new;
        source  cylinderToCell;
        sourceInfo
        {
            p1      (0 -0.07 0); // 4,3 cm abaixo da pa (fora da casca de transicao de 3 cm, reduzindo o jato radial MRF)
            p2      (0  0.05 0); // 3,9 cm acima da pa (fora da casca de transicao de 3 cm)
            radius  0.56;        // 5,2 cm de folga na ponta (na malha uniforme nivel 3, sem cortar a ponta da pa)
        }
    }
    {
        name    innerCylinder;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        sourceInfo
        {
            set     innerCylinderSet;
        }
    }
);

