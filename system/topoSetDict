FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

actions
(
    {
        name    innerCylinderSet;
        type    cellSet;
        action  new;
        source  cylinderToCell;
        sourceInfo
        {
            p1      (0 -0.14 0); // Dentro da refinementBox (Y >= -0.15m) e fora das camadas de transicao da pa
            p2      (0  0.14 0); // Mantido no valor original estavel (+14 cm a montante, dentro da refinementBox)
            radius  0.58;        // Mantido no valor original estavel (58 cm, fora da transicao nivel 8->3 da ponta)
        }
    }
    {
        name    innerCylinder;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        sourceInfo
        {
            set     innerCylinderSet;
        }
    }
);

