#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------

# Desativar probing grafico do hwloc e desligar DISPLAY
export HWLOC_COMPONENTS="-gl"
unset DISPLAY

echo "Limpando solucao anterior..."
rm -f log.topoSet log.decomposePar log.foamRun log.simpleFoam log.reconstructPar
rm -rf processor*
rm -rf [1-9]* postProcessing
rm -rf 0
cp -r 0.orig 0

echo "Decompondo campos para 16 nucleos..."
runApplication decomposePar

echo "Executando foamRun em paralelo..."
runParallel $(getApplication)

echo "Reconstruindo campos do tempo final..."
runApplication reconstructPar -latestTime

echo "Simulacao finalizada com sucesso! Abra results.foam no ParaView."
#------------------------------------------------------------------------------
