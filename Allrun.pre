#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------

# Limpar logs, diretorio 0 e malha antiga para garantir que o runApplication execute todas as etapas
rm -f log.blockMesh log.surfaceFeatures log.surfaceFeatureExtract log.decomposePar log.snappyHexMesh log.reconstructParMesh log.reconstructPar log.renumberMesh log.topoSet
rm -rf 0 constant/polyMesh processor*

# 1. Geracao da malha de fundo
runApplication blockMesh

# 2. Extracao de caracteristicas geometricas (.eMesh)
# No OpenFOAM-dev (Foundation), o utilitario e surfaceFeatures
if command -v surfaceFeatures >/dev/null 2>&1; then
    runApplication surfaceFeatures
else
    runApplication surfaceFeatureExtract
fi

# 3. Decomposicao da malha de fundo para gerar a malha em paralelo (16 nucleos)
runApplication decomposePar

# 4. Geracao da malha em paralelo (rotor, cellZone/faceZone cilindrica conformada e camadas limite)
runParallel snappyHexMesh -overwrite

# 5. Reconstrucao da malha refinada para constant/polyMesh
if command -v reconstructParMesh >/dev/null 2>&1; then
    runApplication reconstructParMesh -constant
else
    runApplication reconstructPar -constant
fi
rm -rf processor*
rm -f log.decomposePar log.reconstructPar

# 6. Renumeracao para otimizar largura de banda da matriz (preserva cellZones e faceZones)
runApplication renumberMesh -overwrite

# 7. Restaurar campos limpos para a simulacao
restore0Dir

#------------------------------------------------------------------------------
