FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      MRFProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

MRF1
{
    cellZone            innerCylinder;
    active              yes;

    // Patches que pertencem a cellZone mas nao devem rotacionar (opcional/vazio)
    nonRotatingPatches  ();

    origin              (0 -0.00800165 0); // Centro de rotacao (plano medio do rotor em Y)
    axis                (0 1 0);           // Eixo de rotacao alinhado ao tunel/dominio (+Y)

    // Velocidade angular em rad/s (3473 RPM) via classe Function1 (sentido fisico anti-horario em +Y)
    omega               constant 363.69;
}

